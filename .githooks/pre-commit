set -eo pipefail

# Checks the staged files before each commit. A check whose tool isn't installed is
# skipped with a warning (run `mise install` and `task install`); CI runs every check.
# Install with `task hooks:install`. Skip once with `git commit --no-verify`.

cd "$(git rev-parse --show-toplevel)"
BIN=website/node_modules/.bin
FAILED=0

# main takes changes only through pull requests.
if [[ "$(git symbolic-ref --short -q HEAD)" == "main" ]]; then
  echo "pre-commit: main takes changes only through pull requests. Create a branch first"
  echo "(git switch -c <branch>), or bypass once with git commit --no-verify."
  exit 1
fi

# Sets FILES to the staged (added, copied, modified or renamed) files matching a regex.
stage() {
  FILES=()
  while IFS= read -r file; do FILES+=("$file"); done < <(git diff --cached --name-only --diff-filter=ACMR | grep -E "$1" || true)
  [[ ${#FILES[@]} -gt 0 ]]
}

# Runs a check, or skips it when its tool isn't installed.
check() {
  local name="$1" tool="$2"
  shift 2
  if ! command -v "$tool" > /dev/null; then
    echo "pre-commit: $name skipped ($tool not installed)"
    return 0
  fi
  "$@" || { echo "pre-commit: $name failed"; FAILED=1; }
}

# shellcheck disable=SC2329 # called through check
eslint_staged() {
  (cd website && ./node_modules/.bin/eslint --max-warnings 0 --no-warn-ignored "${@#website/}")
}

# Hands the staged paths to task lint:headers as a file, one path per line, so a path is
# never expanded as shell code.
# shellcheck disable=SC2329 # called through check
headers_staged() {
  local list status=0
  list="$(mktemp)"
  printf '%s\n' "$@" > "$list"
  HEADER_FILES="$list" task lint:headers || status=1
  rm -f "$list"
  return "$status"
}

# shellcheck disable=SC2329 # called through check
stylelint_staged() {
  (cd website && ./node_modules/.bin/stylelint "${@#website/}")
}

check "secrets" gitleaks gitleaks git --pre-commit --staged --no-banner --log-level warn --redact --config .config/linters/gitleaks.toml .
if stage '.'; then
  check "headers" task headers_staged "${FILES[@]}"
fi
if stage '.'; then
  check "secretlint" "$BIN/secretlint" "$BIN/secretlint" --secretlintrc .config/linters/secretlintrc.json --maskSecrets "${FILES[@]}"
fi

# Runs task lint:lockfile against the staged lockfile, not the working copy.
# shellcheck disable=SC2329 # called through check
lockfile_staged() {
  local copy status=0
  copy="$(mktemp)"
  git show :website/pnpm-lock.yaml > "$copy"
  task lint:lockfile LOCKFILE="$copy" || status=1
  rm -f "$copy"
  return "$status"
}
if stage '(^|/)(pnpm-lock\.yaml|package-lock\.json|yarn\.lock)$'; then
  check "lockfile" task lockfile_staged
fi

if stage '.'; then
  check "editorconfig" editorconfig-checker editorconfig-checker -config .config/linters/editorconfig-checker.json "${FILES[@]}"
fi
if stage '\.(md|mdx|astro|ts|css|yml)$|^\.gitmessage$'; then
  check "spelling" "$BIN/cspell" "$BIN/cspell" lint --config .config/spelling/cspell.json --no-progress --no-summary --dot --no-must-find-files "${FILES[@]}"
fi
if stage '\.md$'; then
  check "markdown" "$BIN/markdownlint-cli2" "$BIN/markdownlint-cli2" --config .config/linters/.markdownlint-cli2.jsonc "${FILES[@]}"
  check "inclusive language" "$BIN/alex" "$BIN/alex" --quiet "${FILES[@]}"
fi
if stage '^website/src/content/posts/.*\.mdx$'; then
  check "inclusive language" "$BIN/alex" "$BIN/alex" --quiet --mdx "${FILES[@]}"
fi
if stage '^website/src/(content|data)/[^/]*\.json$'; then
  check "inclusive language" "$BIN/alex" "$BIN/alex" --quiet --text "${FILES[@]}"
fi
if stage '^website/.*\.(ts|js|mjs|json|css|md|yml|yaml)$'; then
  check "format" "$BIN/prettier" "$BIN/prettier" --check --ignore-unknown \
    --ignore-path website/.prettierignore --config .config/formatters/prettierrc.json "${FILES[@]}"
fi
if stage '^website/.*\.(ts|js|mjs|astro)$'; then
  check "eslint" "$BIN/eslint" eslint_staged "${FILES[@]}"
fi
if stage '^website/src/.*\.(css|astro)$'; then
  check "stylelint" "$BIN/stylelint" stylelint_staged "${FILES[@]}"
fi
if stage '\.ya?ml$'; then
  # Every YAML file but the generated pnpm-lock.yaml.
  YAML=()
  for file in "${FILES[@]}"; do
    if [[ "$file" != */pnpm-lock.yaml ]]; then YAML+=("$file"); fi
  done
  if [[ ${#YAML[@]} -gt 0 ]]; then
    check "yamllint" yamllint yamllint --strict -c .config/linters/yamllint.yml "${YAML[@]}"
  fi
fi
if stage '\.sh$|^\.githooks/'; then
  check "shellcheck" shellcheck shellcheck "${FILES[@]}"
fi
if stage '\.(tf|tftest\.hcl)$'; then
  check "tofu fmt" tofu tofu fmt -check -diff "${FILES[@]}"
fi
if stage '^\.github/workflows/'; then
  check "actionlint" actionlint actionlint "${FILES[@]}"
fi

exit "$FAILED"
