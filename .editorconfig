# Author: Jimmy Kurian

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown and MDX: two trailing spaces are a hard line break.
[*.{md,mdx}]
trim_trailing_whitespace = false

# Exported diagrams and logos are written by tools on one line; leave them as they are.
[*.svg]
insert_final_newline = unset
trim_trailing_whitespace = unset
