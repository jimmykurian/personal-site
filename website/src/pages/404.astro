---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page does not exist." noindex>
  <section class="wrap missing" aria-labelledby="missing-title">
    <div class="ledger ledger--bare">
      <div class="ledger__label">
        <p class="caps">404</p>
      </div>
      <div class="ledger__body">
        <h1 id="missing-title" class="display missing__title">Nothing <em>here</em>.</h1>
        <p class="missing__text">The page may have moved when the site was rebuilt. Try the <a href="/" class="text-link">home page</a> or the <a href="/writing/" class="text-link">writing</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .missing {
    padding-block: clamp(64px, 10vw, 140px);
  }

  .missing__title {
    font-size: clamp(44px, 6vw, 84px);
    line-height: 1;
  }

  .missing__text {
    max-width: 560px;
    font-size: 18px;
  }

  .missing__text .text-link {
    min-height: 0;
  }
</style>
