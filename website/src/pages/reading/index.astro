import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Ledger from '../../components/Ledger.astro';
import WritingHero from '../../components/WritingHero.astro';
import BookRows from '../../components/BookRows.astro';
import site from '../../data/site.json';

type Book = CollectionEntry<'books'>;

const books = await getCollection('books');
const current = books.filter((b) => b.data.shelf === 'currently-reading');

// Newest first; books without a finish date sort by when they were added, at the end.
const newest = (a: Book, b: Book) =>
  Number(Boolean(b.data.readAt)) - Number(Boolean(a.data.readAt)) ||
  (b.data.readAt ?? b.data.addedAt).getTime() - (a.data.readAt ?? a.data.addedAt).getTime();

// Favorites keep the shelf's own order, as on the Goodreads profile.
const favorites = books.filter((b) => b.data.shelf === 'favorites').sort((a, b) => a.data.position - b.data.position);

// The software-engineering shelf mixes finished books with ones still to read.
const shelf = (name: string) => books.filter((b) => b.data.shelf === name);
const engineering = shelf('software-engineering');
const engineeringGroups = [
  ['Read', engineering.filter((b) => !b.data.toRead).sort(newest)],
  ['To read', engineering.filter((b) => b.data.toRead).sort(newest)],
].filter(([, list]) => list.length > 0) as [string, Book[]][];

// Goodreads asks logged-out visitors to sign in for shelf lists, so "the full list" links
// to the profile, which stays public.
const count = (n: number) => `${n} ${n === 1 ? 'book' : 'books'}`;
---

<Base
  title="Reading"
  description={`${site.name}'s current reading and software-engineering shelf, with ratings. Synced from Goodreads.`}
  current="reading"
>
  <WritingHero
    label="Reading"
    title="What I'm reading."
    link={{ href: site.links.goodreads, label: 'Follow on Goodreads' }}
  >
    <Fragment slot="title">What I'm <em>reading</em>.</Fragment>
    <Fragment slot="intro">
      The books in hand, my favorites, and my software-engineering shelf: what I've read, rated out of five, and
      what's next. Synced nightly from Goodreads.<br />
      <a href={site.links.goodreads}>See the full list on Goodreads</a>.
    </Fragment>
  </WritingHero>

  {
    current.length > 0 && (
      <Ledger id="current" label="Currently reading" labelIsHeading>
        <ul class="shelf">
          {current.map(({ data }) => (
            <li class="shelf__book">
              {data.cover && (
                <Image src={data.cover} alt="" inferSize widths={[96, 192]} sizes="96px" class="shelf__cover" loading="eager" />
              )}
              <div class="shelf__text">
                <a href={data.href} class="list-title">
                  {data.title}
                </a>
                {data.subtitle && <p class="shelf__subtitle">{data.subtitle}</p>}
                <p class="note">{data.author}</p>
              </div>
            </li>
          ))}
        </ul>
      </Ledger>
    )
  }

  {
    favorites.length > 0 && (
      <Ledger id="favorites" label="Favorites" labelIsHeading note={count(favorites.length)}>
        <ul class="covers">
          {favorites.map(({ data }) => (
            <li class="covers__book">
              <a href={data.href} class="covers__link">
                {data.cover ? (
                  <Image
                    src={data.cover}
                    alt=""
                    inferSize
                    widths={[160, 320]}
                    sizes="(max-width: 640px) 45vw, 160px"
                    class="covers__img"
                  />
                ) : (
                  <span class="covers__img covers__img--blank" />
                )}
                <span class="covers__title">{data.title}</span>
              </a>
              <span class="note">{data.author}</span>
            </li>
          ))}
        </ul>
      </Ledger>
    )
  }

  {
    engineering.length > 0 && (
      <Ledger
        id="software-engineering"
        label="Software engineering"
        labelIsHeading
        note={`${count(engineering.length)}, read and on deck`}
      >
        <BookRows groups={engineeringGroups} />
      </Ledger>
    )
  }
</Base>

<script>
  import { track } from '../../lib/track';

  // Each list shows its first 10 books, then 10 more per click. Without JavaScript every
  // book stays listed.
  const STEP = 10;

  document.querySelectorAll<HTMLElement>('[data-paged]').forEach((list) => {
    const rows = [...list.children] as HTMLElement[];
    const more = list.nextElementSibling as HTMLElement | null;
    if (!more?.classList.contains('more') || rows.length <= STEP) return;

    const button = more.querySelector('button')!;
    const status = more.querySelector('.more__count')!;
    let shown = STEP;

    const render = () => {
      rows.forEach((row, i) => (row.hidden = i >= shown));
      const left = rows.length - shown;
      more.hidden = left <= 0;
      button.textContent = `Show ${Math.min(STEP, left)} more`;
      status.textContent = `${shown} of ${rows.length}`;
    };

    button.addEventListener('click', () => {
      const next = rows[shown];
      shown += STEP;
      track('reading_show_more');
      render();
      next?.querySelector('a')?.focus({ preventScroll: true });
    });
    render();
  });
</script>

<style>
  .shelf {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px;
  }

  .shelf__book {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  :global(.shelf__cover) {
    flex: none;
    width: 96px;
    height: auto;
    border: 1px solid var(--mist);
  }

  .shelf__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .shelf__subtitle {
    font-family: var(--serif);
    font-style: italic;
    font-size: 17px;
    line-height: 1.35;
  }

  /* Favorites: covers cropped to one size, standing on a shelf rule. */
  .covers {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(128px, 1fr));
    gap: 32px 24px;
  }

  .covers__book {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .covers__link {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .covers__link:hover {
    text-decoration: none;
  }

  :global(.covers__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border: 1px solid var(--mist);
    box-shadow: 0 6px 0 -3px var(--ink);
    transition: transform 0.2s ease;
  }

  .covers__img--blank {
    background: var(--mist);
  }

  .covers__link:hover :global(.covers__img) {
    transform: translateY(-4px);
  }

  .covers__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.3;
  }

  .covers__link:hover .covers__title {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.covers__img) {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .covers {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 16px;
    }
  }
</style>
