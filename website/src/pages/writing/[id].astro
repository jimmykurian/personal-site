---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, readingMinutes } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, canonical, draft } = post.data;
---

<Base title={title} description={description} current="writing" canonical={canonical} type="article" publishedTime={pubDate}>
  <article class="wrap post" aria-labelledby="post-title">
    <header class="post__head">
      <div class="post__label">
        <a href="/writing/" class="caps post__back">Writing</a>
      </div>
      <div class="post__main">
        <h1 id="post-title" class="display post__title">{title}</h1>
        <p class="post__dek">{description}</p>
      </div>
    </header>

    <div class="ledger post__ledger">
      <aside class="ledger__label post__meta meta">
        {draft && <p class="caps caps-sm">Draft</p>}
        <p>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {
            updatedDate && (
              <>
                <br />
                Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </>
            )
          }
        </p>
        <p>{readingMinutes(post.body)} min read</p>
        {
          tags.length > 0 && (
            <p class="post__tags">
              {tags.map((t) => (
                <span>{t}</span>
              ))}
            </p>
          )
        }
        {
          canonical && (
            <p>
              First published at <a href={canonical}>{new URL(canonical).hostname}</a>
            </p>
          )
        }
      </aside>
      <div class="ledger__body prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .post {
    padding-bottom: var(--section-space);
  }

  .post__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 16px var(--col-gap);
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: 40px;
  }

  .post__label {
    flex: 0 0 var(--label-col);
  }

  .post__back {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--accent-small);
  }

  .post__main {
    flex: 1 1 600px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .post__title {
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 1.04;
  }

  .post__dek {
    max-width: 640px;
    font-size: 19px;
    line-height: 1.5;
  }

  .post__meta {
    gap: 6px;
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
  }

  @media (max-width: 860px) {
    .post__head {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .post__label,
    .post__main {
      flex-basis: auto;
    }

    .post__meta {
      flex-flow: row wrap;
      gap: 0 16px;
    }
  }

  /* Body copy. Content is rendered from MDX, so these reach into it. */
  .prose {
    display: block;
    max-width: 680px;
    font-size: 18px;
    line-height: 1.7;
  }

  .prose > :global(* + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    margin-top: 1.8em;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .prose :global(h3) {
    margin-top: 1.6em;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 23px;
    line-height: 1.25;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(blockquote) {
    padding-left: 20px;
    border-left: 2px solid var(--mist);
    font-family: var(--serif);
    font-style: italic;
    font-size: 22px;
    line-height: 1.45;
  }

  .prose :global(code) {
    font-size: 0.88em;
  }

  .prose :global(pre) {
    padding: 18px 20px;
    overflow-x: auto;
    border-top: 1px solid var(--mist);
    border-bottom: 1px solid var(--mist);
    font-size: 15px;
    line-height: 1.55;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--mist);
    margin-block: 2em;
  }

  .prose :global(img) {
    border: 1px solid var(--mist);
  }
</style>
