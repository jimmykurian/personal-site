---
/**
 * @file WritingHero.astro
 * @author Jimmy Kurian
 * @copyright Copyright (c) 2026 Jimmy Kurian. All rights reserved. See LICENSE.
 */
interface Props {
  label: string;
  title: string;
  intro?: string;
  link?: { href: string; label: string };
}

const { label, title, intro, link = { href: '/rss.xml', label: 'Subscribe via RSS' } } = Astro.props;
---

<section class="page-hero wrap" aria-labelledby="page-title">
  <div class="page-hero__label">
    <p class="caps page-hero__eyebrow">{label}</p>
    <a href={link.href} class="text-link page-hero__rss">{link.label}</a>
  </div>
  <div class="page-hero__main">
    <h1 id="page-title" class="display page-hero__title"><slot name="title">{title}</slot></h1>
    {
      Astro.slots.has('intro') ? (
        <p class="page-hero__intro">
          <slot name="intro" />
        </p>
      ) : (
        intro && <p class="page-hero__intro">{intro}</p>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 24px var(--col-gap);
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: 40px;
  }

  .page-hero__label {
    flex: 0 0 var(--label-col);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .page-hero__eyebrow {
    color: var(--accent-small);
  }

  .page-hero__rss {
    min-height: 40px;
    font-size: 14px;
  }

  .page-hero__main {
    flex: 1 1 600px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .page-hero__title {
    font-size: clamp(40px, 4.8vw, 64px);
    line-height: 1.02;
  }

  .page-hero__intro {
    max-width: 640px;
    font-size: 18px;
    line-height: 1.55;
  }

  /* Links inside the intro stay inline so they don't stretch the line. */
  .page-hero__intro :global(a) {
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 860px) {
    .page-hero {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .page-hero__main {
      flex-basis: auto;
    }

    .page-hero__label {
      flex-basis: auto;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
