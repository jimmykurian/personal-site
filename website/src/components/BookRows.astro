---
// Book list for /reading/: a group label on the first row of each group, the title and
// author, and the rating. The page script shows it 10 rows at a time.
import type { CollectionEntry } from 'astro:content';

interface Props {
  groups: [string, CollectionEntry<'books'>[]][];
}

const { groups } = Astro.props;
const count = (n: number) => `${n} ${n === 1 ? 'book' : 'books'}`;
const total = groups.reduce((n, [, list]) => n + list.length, 0);
---

<ul class="rows" data-paged>
  {
    groups.map(([label, list]) =>
      list.map(({ data }, i) => (
        <li class="row book">
          <p class="row__date">
            {i === 0 && (
              <>
                <span class="meta-num book__group">{label}</span>
                <span class="note">{count(list.length)}</span>
              </>
            )}
          </p>
          <div class="row__body">
            <a href={data.href} class="book__title">
              {data.title}
            </a>
            <p class="note">{data.author}</p>
          </div>
          {data.rating > 0 && (
            <p class="stars" role="img" aria-label={`Rated ${data.rating} of 5`}>
              <span aria-hidden="true">
                {'★'.repeat(data.rating)}
                <span class="stars__empty">{'★'.repeat(5 - data.rating)}</span>
              </span>
            </p>
          )}
        </li>
      )),
    )
  }
</ul>
{
  total > 10 && (
    <p class="more" hidden>
      <button type="button" class="btn">
        Show 10 more
      </button>
      <span class="note more__count" />
    </p>
  )
}

<style>
  .book {
    padding: 14px 0;
  }

  .book .row__date {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .book__group {
    font-size: 15px;
    font-weight: 600;
  }

  .book__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
  }

  .stars {
    flex: none;
    margin-left: auto;
    font-family: system-ui, sans-serif;
    font-size: 15px;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .stars__empty {
    color: var(--mist);
  }

  .more {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }

  .book[hidden],
  .more[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .book .row__date:empty {
      display: none;
    }

    .book .row__date {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
      padding-top: 8px;
    }

    .stars {
      margin-left: 0;
    }
  }
</style>
