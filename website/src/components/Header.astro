---
import Icon from './Icon.astro';
import site from '../data/site.json';

interface Props {
  current?: 'home' | 'writing' | 'reading';
}

const { current = 'home' } = Astro.props;

const links = [
  { href: '/#experience', label: 'Experience' },
  { href: '/#service', label: 'Service' },
  { href: '/#projects', label: 'Projects' },
  { href: '/writing/', label: 'Writing', key: 'writing' },
  { href: '/reading/', label: 'Reading', key: 'reading' },
  { href: '/#teaching', label: 'Teaching' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header wrap">
  <div class="site-header__bar">
    <a href="/" class="wordmark" aria-current={current === 'home' ? 'page' : undefined}>{site.name}</a>

    <nav aria-label="Primary" class="nav nav--wide">
      {
        links.map((l) => (
          <a href={l.href} class="nav__link" aria-current={l.key === current ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href="/#resume" class="btn nav__resume">Resume</a>
    </nav>

    <details class="menu">
      <summary class="menu__toggle">
        <span class="menu__open">Menu <Icon name="menu" size={16} /></span>
        <span class="menu__close">Close <Icon name="close" size={16} /></span>
      </summary>
      <nav aria-label="Primary" class="menu__panel">
        {
          links.map((l) => (
            <a href={l.href} class="menu__link" aria-current={l.key === current ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
        <a href="/#resume" class="menu__link">Resume</a>
      </nav>
    </details>
  </div>
  <div class="site-header__rule" aria-hidden="true"></div>
</header>

<script is:inline>
  // Close the phone menu after following an in-page link.
  document.querySelectorAll('.menu__link').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>

<style>
  .site-header {
    position: relative;
    z-index: 5;
  }

  .site-header__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    padding: 20px 0 16px;
    border-bottom: 2px solid var(--ink);
  }

  .site-header__rule {
    margin-top: 3px;
    border-top: 1px solid var(--ink);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: 27px;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .wordmark:hover {
    text-decoration: none;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 2px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
  }

  .nav__link[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .nav__resume {
    min-height: 40px;
    padding: 0 16px;
    margin-left: 12px;
  }

  .menu {
    display: none;
  }

  @media (max-width: 860px) {
    .site-header__bar {
      flex-wrap: nowrap;
      padding: 12px 0 10px;
    }

    .wordmark {
      font-size: 24px;
    }

    .nav--wide {
      display: none;
    }

    .menu {
      display: block;
    }
  }

  .menu__toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--ink);
    border-radius: 2px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .menu__toggle::-webkit-details-marker {
    display: none;
  }

  .menu__open,
  .menu__close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .menu__close,
  .menu[open] .menu__open {
    display: none;
  }

  .menu[open] .menu__close {
    display: inline-flex;
  }

  .menu__panel {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: calc(100% - 4px);
    display: flex;
    flex-direction: column;
    padding: 8px 0 16px;
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
  }

  .menu__link {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--mist);
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 500;
  }

  .menu__link[aria-current='page'] {
    color: var(--accent);
  }
</style>
