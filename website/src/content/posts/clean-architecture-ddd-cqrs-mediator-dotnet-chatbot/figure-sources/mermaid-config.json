{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Libre Franklin, Helvetica Neue, Helvetica, Arial, sans-serif",
    "fontSize": "14px",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#111314",
    "primaryBorderColor": "#111314",
    "lineColor": "#111314",
    "textColor": "#111314",
    "secondaryColor": "#b4cdc2",
    "secondaryBorderColor": "#111314",
    "secondaryTextColor": "#111314",
    "tertiaryColor": "#f4f8f6",
    "tertiaryBorderColor": "#b4cdc2",
    "tertiaryTextColor": "#111314",
    "clusterBkg": "#f6f9f8",
    "clusterBorder": "#b4cdc2",
    "titleColor": "#111314",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#ffffff",
    "actorBorder": "#111314",
    "actorTextColor": "#111314",
    "actorLineColor": "#b4cdc2",
    "signalColor": "#111314",
    "signalTextColor": "#111314",
    "labelBoxBkgColor": "#b4cdc2",
    "labelBoxBorderColor": "#111314",
    "labelTextColor": "#111314",
    "loopTextColor": "#111314",
    "noteBkgColor": "#f5ece7",
    "noteBorderColor": "#a36752",
    "noteTextColor": "#111314",
    "activationBkgColor": "#b4cdc2",
    "activationBorderColor": "#111314",
    "sequenceNumberColor": "#ffffff"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "basis",
    "padding": 12,
    "nodeSpacing": 34,
    "rankSpacing": 42,
    "useMaxWidth": false,
    "wrappingWidth": 600,
    "subGraphTitleMargin": {
      "top": 6,
      "bottom": 6
    }
  },
  "sequence": {
    "actorMargin": 22,
    "messageMargin": 36,
    "boxMargin": 8,
    "noteMargin": 8,
    "mirrorActors": false,
    "useMaxWidth": false,
    "wrap": false,
    "width": 200,
    "height": 60
  },
  "markdownAutoWrap": false,
  "look": "classic",
  "htmlLabels": false
}
