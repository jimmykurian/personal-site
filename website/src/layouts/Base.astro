---
/**
 * @file Base.astro
 * @author Jimmy Kurian
 * @copyright Copyright (c) 2026 Jimmy Kurian. All rights reserved. See LICENSE.
 */
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'writing' | 'reading';
  /** Overrides the page's own URL, for posts first published elsewhere. */
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Keeps the page out of search results, with no canonical URL (the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  current,
  canonical,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-default.png', Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.href,
  jobTitle: site.jobTitle,
  worksFor: { '@type': 'Organization', name: site.employer },
  address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL' },
  sameAs: [site.links.linkedin, site.links.github, site.links.stackoverflow],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}, writing`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload />

    {current === 'home' && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
