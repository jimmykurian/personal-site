{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    "schedule:weekends"
  ],
  "enabledManagers": ["npm", "github-actions", "terraform", "mise"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "One PR a week for minor and patch updates; majors get their own PRs.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "minor and patch updates"
    },
    {
      "description": "The azurerm pin is ~> 5.8.0 in every module, and the pin check needs them equal.",
      "matchManagers": ["terraform"],
      "groupName": "OpenTofu providers"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  }
}
